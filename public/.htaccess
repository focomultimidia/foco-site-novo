# ── Cache — resolve o audit "Use ciclos de vida eficientes de cache" do
#    PageSpeed Insights (1.822 KiB de economia estimada, TTL "None" em
#    praticamente todo asset próprio). Nada disso existia antes: sem
#    Cache-Control, o navegador rebaixa a revalidação de tudo a cada visita.
#
#    O Vite já cuida do cache-busting sozinho — cada build gera nomes com
#    hash de conteúdo (ex.: index-C2nDYNuk.js). Um arquivo com hash NUNCA
#    muda de conteúdo sob o mesmo nome (se o conteúdo mudar, o hash muda
#    junto), então pode ficar em cache pelo máximo período com "immutable"
#    sem risco de servir versão desatualizada. O único arquivo que NÃO pode
#    cachear assim é o index.html raiz — ele referencia os hashes atuais, e
#    precisa ser revalidado a cada deploy.
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets com hash no nome (JS/CSS/imagens/fontes de build) — 1 ano, immutable.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — sempre revalidado (referencia os hashes da build atual).
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # robots.txt / sitemap.xml — podem mudar, cache curto é suficiente.
  <FilesMatch "\.(txt|xml)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
</IfModule>

# ── Compressão — reduz o peso de transferência de texto (JS/CSS/HTML/SVG). ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Redirects 301 do site antigo (URLs .html) pras rotas do site novo ──────
#    Preserva o ranking já conquistado nessas páginas no Google — sem isso,
#    no dia da troca elas passam a devolver 404 e a autoridade acumulada se
#    perde em vez de ser transferida pro slug novo. Precisa vir ANTES do
#    bloco de SPA fallback abaixo: mod_alias resolve na entrada da request,
#    então tanto faz a ordem entre os dois módulos, mas manter os redirects
#    301 agrupados e comentados aqui facilita auditar o mapeamento inteiro
#    de uma vez (ver plano de ação de conteúdo/SEO para o raciocínio por
#    trás de cada destino).
<IfModule mod_alias.c>
  Redirect 301 /software-gestao-hoteleira-pms.html /sistema-de-gestao-hoteleira-pms
  Redirect 301 /motor-de-reservas.html /motor-de-reservas
  Redirect 301 /gestor-de-canais-channel-manager.html /gestor-de-canais-channel-manager
  Redirect 301 /reviews-satisfacao-hotel-experiencia-hospede-nps.html /aplicativo-de-hospedagem
  Redirect 301 /focopay-pagamentos-automatico-de-reservas-para-hoteis.html /software-de-pagamentos
  Redirect 301 /aplicativo-de-hospedagem-focopass.html /aplicativo-de-hospedagem
  Redirect 301 /site-hotel.html /sites-para-hoteis-e-pousadas
  Redirect 301 /marketing-para-hoteis.html /marketing-para-hoteis
</IfModule>

# ── Redirects 301 — renomeação de rotas (URLs limpas antigas, já indexadas,
#    pro novo nome) ──────────────────────────────────────────────────────
#    Preserva a indexação/ranking que essas URLs já tinham antes da troca de
#    nome — sem isso, quem chega por um link salvo, um resultado de busca
#    antigo ou um backlink externo cairia direto na página 404 (a rota
#    antiga não existe mais no React Router, ver App.tsx).
<IfModule mod_alias.c>
  Redirect 301 /channel-manager /gestor-de-canais-channel-manager
  Redirect 301 /gestao-hoteleira /sistema-de-gestao-hoteleira-pms
  Redirect 301 /experiencia-do-hospede /aplicativo-de-hospedagem
  Redirect 301 /otheo-ai /inteligencia-artificial-para-hoteis-e-pousadas
  Redirect 301 /site-hoteleiro /sites-para-hoteis-e-pousadas
</IfModule>

# ── Redirects 301 — slugs numéricos herdados da migração do WordPress
#    (posts sem slug próprio no banco antigo, salvos só com o ID) pro slug
#    descritivo definitivo. Mesmo motivo dos blocos acima: sem isso, quem
#    chega pelo link antigo (ou o Google, que já indexou a URL numérica)
#    cai em 404 em vez de ser encaminhado pro post de verdade.
#
#    `RedirectMatch` com âncoras (^...$), não `Redirect` puro: o `Redirect`
#    do mod_alias casa por PREFIXO, não por caminho exato — `Redirect 301
#    /blog/3062-2 ...` também redirecionaria `/blog/3062-2-qualquer-coisa`
#    se um post assim existisse um dia. Sem impacto hoje (nenhum slug atual
#    começa com esses dois prefixos), mas as âncoras fecham essa brecha de
#    vez em vez de depender de nenhuma colisão futura por sorte. ─────────
<IfModule mod_alias.c>
  RedirectMatch 301 ^/blog/3062-2$ /blog/sistemas-para-hotel-guia-completo-para-modernizar-sua-gestao-e-aumentar-a-rentabilidade
  RedirectMatch 301 ^/blog/3411-2$ /blog/lei-da-hospedagem-em-2026-guia-atualizado-para-hoteis-e-pousadas
</IfModule>

# ── Canonicalização de URL + SPA fallback ─────────────────────────────────
#
#    O problema que os dois primeiros blocos abaixo resolvem: desde que o
#    `generate-static-meta.mjs` passou a gerar um dist/<rota>/index.html por
#    rota, cada rota virou um DIRETÓRIO real no servidor. Com isso, o
#    mod_dir do Apache (DirectorySlash On, o padrão) passou a responder
#    301 em /crm-hoteleiro → /crm-hoteleiro/ — e a condição `!-d` do
#    fallback abaixo já não salva, justamente porque agora o diretório
#    existe. O Search Console viu o estrago pelos dois lados ao mesmo
#    tempo: 117 URLs sem barra em "Página com redirecionamento" (o 301) e
#    122 URLs com barra em "Página alternativa com tag canônica adequada"
#    (essas respondem 200, mas o <link rel="canonical"> aponta pra versão
#    sem barra — a que redireciona). Nenhum dos dois caminhos chega a ser
#    indexado: 239 das 276 páginas não indexadas da propriedade vinham daqui.
#
#    A forma canônica do site é SEM barra final — é o que o sitemap.xml
#    declara, o que o <link rel="canonical"> de cada página aponta e o que
#    o React Router usa nos links internos. Estes dois blocos fazem o
#    servidor concordar com isso, em vez de contradizê-lo.

# Com DirectorySlash Off o mod_dir para de emitir aquele 301. A regra (2)
# abaixo é que passa a resolver a rota, servindo o HTML pré-renderizado do
# diretório direto na URL sem barra — 200, sem salto intermediário.
#
# `IndexIgnore *` é a rede de proteção que vem junto: sem o redirect do
# mod_dir, um diretório SEM index.html poderia cair no mod_autoindex e
# listar o conteúdo. Na prática isso não chega a acontecer — /assets não
# casa a regra (2), cai no fallback (3) e recebe o index.html do SPA antes
# de o autoindex entrar —, mas a linha fecha a porta de vez.
#
# É `IndexIgnore`, e não o `Options -Indexes` que seria o reflexo natural
# aqui, por causa do AllowOverride: `Options` exige `AllowOverride Options`,
# que este servidor pode não liberar — e um .htaccess com diretiva não
# autorizada não é ignorado, ele derruba o site inteiro com 500 ("Options
# not allowed here"). `IndexIgnore` e `DirectorySlash` estão no grupo
# `Indexes`, o mesmo do `ExpiresActive`/`ExpiresDefault` do bloco de cache
# lá em cima — que hoje funciona em produção, o que prova que esse grupo
# está liberado.
IndexIgnore *
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Versão com barra final → 301 pra versão sem barra (a canônica).
  #    Recolhe as 122 URLs que hoje o Google conhece na forma /rota/ e as
  #    devolve pra forma única. A raiz "/" fica de fora: ela É a barra.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # 2) Existe dist/<rota>/index.html? Serve ele direto, na URL sem barra.
  #    É o que o mod_dir fazia via 301 — agora sem o 301. Sem essa regra,
  #    /crm-hoteleiro cairia no fallback (3) e receberia o index.html raiz,
  #    com o <head> genérico da Home, perdendo todo o meta por página que o
  #    generate-static-meta.mjs existe pra produzir.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 3) SPA fallback — as rotas do React Router que não têm HTML próprio
  #    (ex.: /blog/busca com query) caem no index.html raiz. Sem isso,
  #    entrar direto nelas ou recarregar dá 404 no Apache, que tenta achar
  #    um arquivo real com esse nome.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
